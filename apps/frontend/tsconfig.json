{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@tracker/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  // e2e/ is included deliberately: its fixtures are annotated with the shared domain
  // types, and without typechecking them those annotations are claims nobody verifies.
  // A fixture that silently drifts from the real API shape makes the suite green while
  // testing something the server never sends.
  "include": ["src/**/*", "e2e/**/*"]
}
